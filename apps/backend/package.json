{
	"name": "backend",
	"version": "0.0.1",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build && tsc-alias -p tsconfig.build.json",
		"start": "nest start",
		"dev": "nest start --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,test}/**/*.ts\" --fix",
		"check-types": "tsc --noEmit",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.mts"
	},
	"dependencies": {
		"@nestjs/common": "11.2.5",
		"@nestjs/config": "12.0.0",
		"@nestjs/core": "11.2.5",
		"@nestjs/platform-fastify": "11.2.5",
		"nestjs-pino": "5.2.0",
		"pino": "10.3.1",
		"pino-http": "11.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@nestjs/cli": "11.0.24",
		"@nestjs/schematics": "11.1.0",
		"@nestjs/testing": "11.2.5",
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@swc/core": "1.16.2",
		"@types/node": "26.6.2",
		"@types/supertest": "^7.2.0",
		"@vitest/coverage-v8": "4.1.11",
		"eslint": "^10.6.0",
		"pino-pretty": "13.1.3",
		"prettier": "^3.9.4",
		"supertest": "^7.2.2",
		"tsc-alias": "1.9.5",
		"typescript": "6.0.3",
		"unplugin-swc": "2.0.0",
		"vitest": "4.1.11"
	}
}
