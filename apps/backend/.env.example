# API 서버가 바인딩할 포트. 미설정 시 3001.
PORT=3001

# pino 로그 레벨 (trace|debug|info|warn|error|fatal|silent). 미설정 시 info.
LOG_LEVEL=info

# production이면 로그를 JSON 그대로, 그 외에는 pino-pretty로 사람이 읽는 형태로 낸다.
NODE_ENV=development

# PostgreSQL 접속 문자열. 로컬은 docker-compose.yml의 postgres와 맞춘다.
DATABASE_URL=postgresql://postgres:1234@localhost:5432/munjigi

# Valkey 접속 문자열(ioredis라 스킴은 redis://). 로컬은 docker-compose.yml의 valkey와 맞춘다.
# 사용량 카운터·거부 기록 상한·전달 큐가 쓴다.
REDIS_URL=redis://localhost:6379

# access JWT 서명 키. 운영은 충분히 긴 무작위 값(예: openssl rand -base64 48).
JWT_SECRET=change-me

# Google Cloud Console에서 발급한 OAuth 웹 클라이언트 ID. ID 토큰의 audience로 검증한다.
GOOGLE_CLIENT_ID=

# 초대 메일 수락 링크의 프론트 주소. 링크는 {APP_URL}/invitations/{token}.
APP_URL=http://localhost:5173

# 초대 메일 발신 주소. production에서만 SES로 발송하고, SES에서 인증된 도메인이어야 한다.
# SES 인증은 ECS 태스크 역할이라 키를 두지 않는다. 그 외 환경은 발송을 생략하고 로그만 남긴다.
MAIL_FROM=no-reply@munjigi.local

# 전달 워커가 내부망·자기 자신(localhost, 10.x, 169.254.x 등)으로 요청을 보내도 되는가. 로컬 개발에서 localhost
# 목적지를 쓰려면 true. 운영에서는 설정하지 않는다(기본은 차단). 켜면 목적지 주소로 내부망을 읽을 수 있다.
ALLOW_PRIVATE_DESTINATIONS=true

# 서명 시크릿·목적지 헤더·빌링키를 AES-256-GCM으로 암호화하는 키. base64로 인코딩한 32바이트.
# 생성: openssl rand -base64 32. 바꾸면 기존 암호문을 복호화할 수 없다.
ENCRYPTION_KEY=
